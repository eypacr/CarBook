@model List<ContactListDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index">Anasayfa</a></li>
                    <li class="breadcrumb-item active">İletişimler</li>
                </ol>
            </div>

        </div>
    </div>
</div>


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">İletişim Mesajları</h4>
                <p class="card-subtitle mb-4">
                    Mesaj içeriklerini görüntüleyebilmek için mesajın sol kısmındaki + butonuna basınız. Sağ üstteki arama bölümünden ilgili mesajı arayıp sonuçları dinamik olarak listeleyebilirsiniz.
                </p>

                <table id="basic-datatable" class="table dt-responsive nowrap">
                    <thead>
                        <tr>
                            <th>Sayısı</th>
                            <th>Adı</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Metin</th>
                            <th>Aksiyon</th>
                        </tr>
                    </thead>


                    <tbody>
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>@item.Name</td>
                                <td>@item.Subject</td>
                                <td>@item.SendingDate.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</td>
                                <td>@item.Message</td>
                                <td><a href="/Admin/AdminContact/DeleteContact/@item.ContactId" class="btn btn-outline-danger">Sil</a></td>
                                <td><a href="/Admin/AdminContact/UpdateContact/@item.ContactId" class="btn btn-outline-success">Güncelle</a></td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

