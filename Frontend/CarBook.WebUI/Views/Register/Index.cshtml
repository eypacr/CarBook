@model CreateRegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <title>Araç Kiralama - Yeni Üyelik Oluştur</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="MyraStudio" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <link rel="shortcut icon" href="~/Admin/vertical/assets/images/favicon.ico">
    <link href="~/Admin/vertical/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Admin/vertical/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Admin/vertical/assets/css/theme.min.css" rel="stylesheet" type="text/css" />

    <style>
        /* Oval kenarları uygulama */
        .bg-white, .form-control-user, .btn, .img-fluid {
            border-radius: 15px !important; /* Oval kenarlar için radius değeri */
        }
    </style>
</head>

<body>

    <div>
        <div class="container">
            <div class="row">
                <div class="col-lg-6 d-flex align-items-center justify-content-center">
                    <div class="d-flex align-items-center min-vh-100">
                        <div class="w-100 d-block bg-white shadow-lg rounded my-5">
                            <img src="~/Admin/vertical/assets/images/KayitOl.jpg" alt="Register Image" class="img-fluid rounded" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="d-flex align-items-center min-vh-100">
                        <div class="w-100 d-block bg-white shadow-lg rounded my-5">
                            <div class="p-5">
                                <div class="text-center mb-5">
                                    <a href="/Default/Index" class="text-dark font-size-22 font-family-secondary">
                                        <i class="mdi mdi-alpha-x-circle"></i> <b>Araç Kiralama</b>
                                    </a>
                                </div>
                                <h1 class="h5 mb-1">Yeni Hesap Oluştur!</h1>
                                <p class="text-muted mb-4">Bir hesabınız yok mu, 1 dakika içinde hesabınızı oluşturun!</p>
                                <form method="post" class="user">
                                    <div class="form-group row">
                                        <div class="col-sm-6 mb-3 mb-sm-0">
                                            <input asp-for="Name" type="text" class="form-control form-control-user" id="exampleFirstName" placeholder="Adınız">
                                            <span class="text-danger" asp-validation-for="Name"></span>
                                        </div>
                                        <div class="col-sm-6">
                                            <input asp-for="Surname" type="text" class="form-control form-control-user" id="exampleLastName" placeholder="Soyadınız">
                                            <span class="text-danger" asp-validation-for="Surname"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <input asp-for="Email" type="email" class="form-control form-control-user" id="exampleInputEmail" placeholder="E-posta Adresiniz">
                                        <span class="text-danger" asp-validation-for="Email"></span>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-sm-6 mb-3 mb-sm-0">
                                            <input asp-for="Username" type="text" class="form-control form-control-user" id="exampleInputUsername" placeholder="Kullanıcı Adınız">
                                            <span class="text-danger" asp-validation-for="Username"></span>
                                        </div>
                                        <div class="col-sm-6">
                                            <input asp-for="Password" type="password" class="form-control form-control-user" id="exampleRepeatPassword" placeholder="Parolanız">
                                            <span class="text-danger" asp-validation-for="Password"></span>
                                        </div>
                                    </div>
                                    <button class="btn btn-success btn-block waves-effect waves-light">
                                        Hesap Oluştur
                                    </button>

                                    <div class="text-center mt-4">
                                        <h5 class="text-muted font-size-16">Sosyal Medya Hesaplarımız</h5>
                                        <ul class="list-inline mt-3 mb-0">
                                            <li class="list-inline-item">
                                                <a href="javascript: void(0);" class="social-list-item border-primary text-primary"><i class="mdi mdi-facebook"></i></a>
                                            </li>
                                            <li class="list-inline-item">
                                                <a href="javascript: void(0);" class="social-list-item border-danger text-danger"><i class="mdi mdi-google"></i></a>
                                            </li>
                                            <li class="list-inline-item">
                                                <a href="javascript: void(0);" class="social-list-item border-info text-info"><i class="mdi mdi-twitter"></i></a>
                                            </li>
                                            <li class="list-inline-item">
                                                <a href="javascript: void(0);" class="social-list-item border-secondary text-secondary"><i class="mdi mdi-github-circle"></i></a>
                                            </li>
                                        </ul>
                                    </div>
                                </form>

                                <div class="row mt-4">
                                    <div class="col-12 text-center">
                                        <p class="text-muted mb-0">Bir Hesabınız Var Mı?  <a href="/Login/Index" class="text-muted font-weight-medium ml-1"><b>Giriş Yap</b></a></p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Admin/vertical/assets/js/jquery.min.js"></script>
    <script src="~/Admin/vertical/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/Admin/vertical/assets/js/metismenu.min.js"></script>
    <script src="~/Admin/vertical/assets/js/waves.js"></script>
    <script src="~/Admin/vertical/assets/js/simplebar.min.js"></script>
    <script src="~/Admin/vertical/assets/js/theme.js"></script>

</body>

</html>
