@model List<GetBlogWithAuthorDetailsDto>

@foreach (var item in Model)
{
    <div class="about-author d-flex p-4 bg-light">
        <div class="bio mr-5">
            <img src="@item.AuthorImageUrl" class="img-fluid mb-4">
        </div>
        <div class="desc">
            <h3>@item.AuthorName</h3>
            <p>
                @{
                    if (item.AuthorDescription?.Length > 230)
                    {
                        @item.AuthorDescription.Substring(0, 230)
                        ;
                    }
                    else
                    {
                        @item.AuthorDescription?.ToString()
                        ;
                    }
                }...
            </p>
        </div>
    </div>
}
