@model PlayBannerDto
@{
    ViewData["Title"] = "PlayBanner";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="banner-container">
    <iframe width="688" height="387" src="@Model.GetEmbedUrl()" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
</div>

<style>
    .banner-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin-top: 0;
    }
</style>
