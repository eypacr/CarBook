@model GetBlogByIdDto
<div class="col-md-8 ftco-animate">

    <h2 class="mb-3">@Model.Title</h2>
    <p>@Model.Description</p>
    
    @await Component.InvokeAsync("_BlogDetailTagComponentPartial",new {id=ViewBag.id})
    @await Component.InvokeAsync("_BlogDetailAuthorAboutComponentPartial", new { id = ViewBag.id })




    <div class="pt-5 mt-5">
        @await Component.InvokeAsync("_CommentListByBlogComponentPartial", new { id = ViewBag.id })
       @*  @await Component.InvokeAsync("_AddCommentComponentPartial") *@

        
    </div>

</div>