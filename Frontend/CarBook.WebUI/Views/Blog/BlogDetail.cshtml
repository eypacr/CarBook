@{
    ViewData["Title"] = "BlogDetail";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section ftco-degree-bg">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("_BlogDetailsMainComponentPartial", new { id = ViewBag.id })
            ﻿<div class="col-md-4 sidebar ftco-animate">
                @await Component.InvokeAsync("_BlogDetailSideBarSearchBoxComponentPartial")
                @await Component.InvokeAsync("_BlogDetailSideBarCategoriesComponentPartial")
                @await Component.InvokeAsync("_BlogDetailSideBarRecentBlogComponentPartial")
                @await Component.InvokeAsync("_BlogDetailsTagCloudComponentPartial", new { id = ViewBag.id })
                @await Component.InvokeAsync("_BlogDetailsParagraphComponentPatial")
            </div>
                @await Component.InvokeAsync("_AddCommentComponentPartial", new { id = ViewBag.id, model = new CommentCreateDto() })
        </div>

    </div>
</section>